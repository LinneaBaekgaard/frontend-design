---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    list-style: none;
    padding-block: 0;

    --card-width: 400px;

    display: flex;
    gap: var(--card-gap);

    overflow-x: auto;
    scroll-snap-type: inline mandatory;

    padding-inline: max(1rem, 50% - var(--content-width) / 2);
    scroll-padding-inline: max(1rem, 50% - var(--content-width) / 2);

    li {
      scroll-snap-align: start;

      background-color: var(--card-background);
      color: var(--text-color);
      border-radius: var(--card-border-radius);
      padding: var(--card-padding);
      flex: 1 0 var(--card-width);
    }
  }
</style>
